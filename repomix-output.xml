	}

	if capturedClaims.UserID != userID {
		t.Errorf("Expected UserID %s, got %s", userID, capturedClaims.UserID)
	}

	if capturedClaims.SessionID != sessionID {
		t.Errorf("Expected SessionID %s, got %s", sessionID, capturedClaims.SessionID)
