      - .env
    environment:
      - AUTH_GRPC_PORT=:${AUTH_GRPC_PORT}
      - USER_SERVICE_URL=user-service:${USER_GRPC_PORT}
      - WALLET_SERVICE_URL=wallet-service:${WALLET_GRPC_PORT}
      - POSTGRES_HOST=postgres
      - POSTGRES_PORT=5432
