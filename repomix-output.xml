	result := scrubString(input)

	// Check that all patterns are scrubbed
	if !contains(result, "[FILTERED:EMAIL]") {
		t.Error("Email should be filtered")
	}
	if !contains(result, "[FILTERED:ETH_ADDRESS]") {
