"""
type RefreshResponse {
  accessToken: String!
  expiresAt: String!
  userId: String!
}

# ============================================
# User Types
# ============================================

type User {
  id: ID!
  status: String!
  createdAt: String!
  profile: Profile
}

type Profile {
  userId: ID!
  username: String
  displayName: String
  avatarUrl: String
  bannerUrl: String
  bio: String
  locale: String
  timezone: String
  socialsJson: String
  updatedAt: String
}

input UpdateProfileInput {
  username: String
  displayName: String
  avatarUrl: String
  bannerUrl: String
  bio: String
  locale: String
  timezone: String
  socialsJson: String
}

# ============================================
# Wallet Types
# ============================================

type WalletLink {
  id: ID!
  userId: ID!
  accountId: String!
  address: String!
  chainId: String!
  isPrimary: Boolean!
  verifiedAt: String
  createdAt: String!
  updatedAt: String!
}

input LinkWalletInput {
  accountId: String!
  address: String!
  chainId: String!
  isPrimary: Boolean!
  type: String
  connector: String
  label: String
}

# ============================================
# Queries
# ============================================

type Query {
  # Auth
  getNonce(accountId: String!, chainId: String!, domain: String!): Nonce!

  # User
  me: User
  getUser(userId: ID!): User

  # Wallet
  myWallets: [WalletLink!]!
  getWallets(userId: ID!): [WalletLink!]!
}

# ============================================
# Mutations
# ============================================

type Mutation {
  # Auth
  verifySiwe(
    accountId: String!
    message: String!
    signature: String!
  ): AuthResponse!

