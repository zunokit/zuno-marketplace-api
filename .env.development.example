# ============================================================
# Development Environment (Air Hot-Reload + Serverless)
# ============================================================
# Setup: cp .env.development.example .env
# Then replace [PLACEHOLDERS] with your credentials

# ============================================================
# Infrastructure Mode
# ============================================================
INFRA_MODE=serverless
ENVIRONMENT=development

# ============================================================
# Service Ports (4xxx range for Air hot-reload)
# ============================================================
AUTH_GRPC_PORT=:4001
USER_GRPC_PORT=:4002
WALLET_GRPC_PORT=:4003
GATEWAY_HTTP_ADDR=:4080

# Service URLs (localhost for Air mode)
AUTH_SERVICE_URL=localhost:4001
USER_SERVICE_URL=localhost:4002
WALLET_SERVICE_URL=localhost:4003

# ============================================================
# JWT Authentication
# ============================================================
JWT_SECRET=dev-secret-key-32-chars-min
REFRESH_SECRET=dev-refresh-secret-32-chars-min
JWT_ACCESS_SECRET=dev-secret-key-32-chars-min
JWT_ACCESS_EXPIRATION_HOURS=1
JWT_REFRESH_EXPIRATION_DAYS=7

# ============================================================
# Serverless Infrastructure
# ============================================================
# Neon (PostgreSQL): https://console.neon.tech/
DATABASE_URL=postgres://postgres:[PASSWORD]@[PROJECT_ID].aws.neon.tech/neondb?sslmode=require

# Upstash (Redis): https://console.upstash.com/
REDIS_URL=redis://default:[PASSWORD]@xxx.upstash.io:6379

# CloudAMQP (RabbitMQ): https://www.cloudamqp.com/
CLOUDAMQP_URL=amqp://[USER]:[PASSWORD]@[HOST]/[VHOST]

# ============================================================
# Sentry (Optional)
# ============================================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ============================================================
# GraphQL Playground
# ============================================================
GRAPHQL_PLAYGROUND=true
