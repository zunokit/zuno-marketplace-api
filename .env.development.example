# ============================================
# Zuno Marketplace - Development Environment
# Infrastructure Mode: Serverless
# ============================================
# This configuration uses external cloud services for development
# without requiring Docker. Free tier accounts:
# - Supabase (PostgreSQL)
# - Upstash (Redis)
# - CloudAMQP (RabbitMQ)
# ============================================

# Infrastructure Mode
INFRA_MODE=serverless

# ============================================
# CORE APPLICATION
# ============================================
ENVIRONMENT=development
PORT=8080

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=your-256-bit-secret-key-here-change-in-production
REFRESH_SECRET=your-256-bit-refresh-secret-key-here-change-in-production

# ============================================
# DATABASE (Supabase)
# ============================================
# Get from: Supabase Project → Settings → Database → Connection string
# Format: postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxx.supabase.co:5432/postgres

# ============================================
# REDIS (Upstash)
# ============================================
# Get from: Upstash Dashboard → Database → Details → REST API
# Format: redis://default:[PASSWORD]@xxx.upstash.io:6379
REDIS_URL=redis://default:[YOUR-PASSWORD]@xxx.upstash.io:6379

# ============================================
# MESSAGE QUEUE (CloudAMQP)
# ============================================
# Get from: CloudAMQP Dashboard → Instance → Details
# Format: amqp://user:password@host/vhost
CLOUDAMQP_URL=amqp://xxx:xxx@xxx.rmq.cloudamqp.com/xxx

# ============================================
# SERVICES PORTS (gRPC)
# ============================================
# Active microservices
AUTH_GRPC_PORT=:50051
USER_GRPC_PORT=:50052
WALLET_GRPC_PORT=:50053

# GraphQL Gateway
GATEWAY_HTTP_ADDR=:8080

# ============================================
# SERVICE URLs (for inter-service communication)
# ============================================
USER_SERVICE_URL=localhost:50052
WALLET_SERVICE_URL=localhost:50053
