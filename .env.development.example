# ============================================================
# Zuno NFT Marketplace - Development Environment
# ============================================================
# Air Hot-Reload + Serverless Infrastructure
#
# Setup:
#   1. cp .env.development.example .env.development
#   2. Replace [PLACEHOLDERS] with actual credentials
#   3. Run: make dev-air-validate
#   4. Start: make dev-air
#
# Free tier accounts needed:
#   - Neon: https://console.neon.tech/ (PostgreSQL)
#   - Upstash: https://console.upstash.com/ (Redis)
#   - CloudAMQP: https://www.cloudamqp.com/ (RabbitMQ)
# ============================================================

# ============================================================
# Environment
# ============================================================
INFRA_MODE=serverless
ENVIRONMENT=development
PORT=4080

# ============================================================
# Service Ports (4xxx range for Air hot-reload)
# ============================================================
AUTH_GRPC_PORT=:4001
USER_GRPC_PORT=:4002
WALLET_GRPC_PORT=:4003
GATEWAY_HTTP_ADDR=:4080

# Service URLs (localhost for local Air services)
USER_SERVICE_URL=localhost:4002
WALLET_SERVICE_URL=localhost:4003

# ============================================================
# Authentication (JWT)
# ============================================================
JWT_SECRET=dev-secret-key-32-chars-min-change-in-production
REFRESH_SECRET=dev-refresh-secret-32-chars-min-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================================
# Database - Neon (Serverless PostgreSQL)
# ============================================================
# Get from: Neon Console → Project → Connection Details
# Format: postgres://postgres:[PASSWORD]@[PROJECT-ID].aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://postgres:[YOUR_PASSWORD]@[PROJECT_ID].aws.neon.tech/neondb?sslmode=require

# Alternative: Direct connection params (if needed)
POSTGRES_HOST=[PROJECT_ID].aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=[YOUR_PASSWORD]
POSTGRES_DATABASE=neondb

# ============================================================
# Cache - Upstash (Serverless Redis)
# ============================================================
# Get from: Upstash Console → Database → Details → REST API
# Format: redis://default:[PASSWORD]@xxx.upstash.io:6379
REDIS_URL=redis://default:[YOUR_PASSWORD]@xxx.upstash.io:6379

# Alternative: Direct connection params
REDIS_HOST=xxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=[YOUR_PASSWORD]

# ============================================================
# Message Queue - CloudAMQP (Serverless RabbitMQ)
# ============================================================
# Get from: CloudAMQP Console → Instance → Details
# Format: amqp://[USER]:[PASSWORD]@[HOST]/[VHOST]
CLOUDAMQP_URL=amqp://[USER]:[PASSWORD]@[HOST]/[VHOST]

# Alternative: Direct connection params
RABBITMQ_HOST=[HOST]
RABBITMQ_PORT=5672
RABBITMQ_USER=[USER]
RABBITMQ_PASSWORD=[PASSWORD]
RABBITMQ_VHOST=[VHOST]
RABBITMQ_EXCHANGE=nft_events

# Management UI (for debugging)
RABBITMQ_MGMT_URL=https://[HOST]/#/

# ============================================================
# Blockchain RPC (Optional - for NFT operations)
# ============================================================
# Ethereum Mainnet
ETHEREUM_RPC_URL=
ETHEREUM_WS_URL=

# Polygon (Matic)
POLYGON_RPC_URL=
POLYGON_WS_URL=

# ============================================================
# IPFS (Optional - for NFT storage)
# ============================================================
IPFS_API_URL=
IPFS_API_KEY=
IPFS_GATEWAY=

# ============================================================
# Sentry - Error Tracking (Optional)
# ============================================================
# Get from: Sentry.io → Settings → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ============================================================
# Feature Flags
# ============================================================
ENABLE_SWAGGER=true
ENABLE_METRICS=false
ENABLE_TRACING=false
ENABLE_CORS=true

# ============================================================
# Logging & Monitoring
# ============================================================
LOG_LEVEL=debug
LOG_FORMAT=console

# Sentry (error tracking)
SENTRY_ENABLED=false
SENTRY_DSN=

# ============================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================
# Comma-separated allowed origins for development
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4080

# ============================================================
# Rate Limiting (Optional)
# ============================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# ============================================================
# Session Configuration
# ============================================================
SESSION_MAX_AGE=604800  # 7 days in seconds
SESSION_COOKIE_NAME=auth_session
