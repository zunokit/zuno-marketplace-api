# ============================================
# CORE APPLICATION
# ============================================
ENVIRONMENT=development
PORT=8080

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=CHANGE_THIS_super_secret_jwt_key_min_32_chars_required
REFRESH_SECRET=CHANGE_THIS_super_secret_refresh_key_min_32_chars_required

# ============================================
# DATABASE
# ============================================
# PostgreSQL (Primary DB)
# Option 1: Local Docker (default)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_IN_PRODUCTION
POSTGRES_DATABASE=nft_marketplace

# Option 2: Supabase (Serverless - for dev without Docker)
# SUPABASE_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxx.supabase.co:5432/postgres
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Redis (Cache)
# Option 1: Local Docker (default)
REDIS_HOST=localhost
REDIS_PORT=6379

# Option 2: Upstash (Serverless - for dev without Docker)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxX...xXxX

# ============================================
# MESSAGE QUEUE
# ============================================
# Option 1: Local Docker (default)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=CHANGE_IN_PRODUCTION
RABBITMQ_EXCHANGE=nft-marketplace

# Option 2: CloudAMQP (Serverless - for dev without Docker)
# CLOUDAMQP_URL=amqps://user:password@xxx.rmq.cloudamqp.com/vhost


# ============================================
# SERVICES PORTS (gRPC)
# ============================================
# Active microservices
AUTH_GRPC_PORT=50051
USER_GRPC_PORT=50052
WALLET_GRPC_PORT=50053

# GraphQL Gateway
GATEWAY_HTTP_ADDR=8081

