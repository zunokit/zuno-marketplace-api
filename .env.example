# ============================================
# CORE APPLICATION
# ============================================
ENVIRONMENT=development
PORT=8080

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=CHANGE_THIS_super_secret_jwt_key_min_32_chars_required
REFRESH_SECRET=CHANGE_THIS_super_secret_refresh_key_min_32_chars_required

# ============================================
# DATABASE
# ============================================
# PostgreSQL (Primary DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_IN_PRODUCTION
POSTGRES_DATABASE=nft_marketplace

# Redis (Cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# MESSAGE QUEUE
# ============================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=CHANGE_IN_PRODUCTION
RABBITMQ_EXCHANGE=nft-marketplace

# ============================================
# BLOCKCHAIN RPC
# ============================================
# Testnet
ETH_SEPOLIA_RPC=https://sepolia.infura.io/v3/your-infura-key

# Local Development
ANVIL_RPC=http://localhost:8545


# ============================================
# SERVICES PORTS (gRPC)
# ============================================
# Active microservices
AUTH_GRPC_PORT=50051
USER_GRPC_PORT=50052
WALLET_GRPC_PORT=50053
COLLECTION_GRPC_PORT=50054
MEDIA_GRPC_PORT=50055

# GraphQL Gateway
GATEWAY_HTTP_ADDR=8081

# Service URLs (for Gateway to connect)
MEDIA_SERVICE_URL=localhost:50055

# ============================================
# METADATA SERVICE (Upload & IPFS)
# ============================================
# Zuno Metadata Service for file uploads, IPFS pinning, ImageKit integration
# Production URL (already deployed on Vercel)
METADATA_SERVICE_URL=https://zuno-marketplace-metadata.vercel.app/api
# Format: zuno_xxxxxxxxxxxxxxxx-key-xxxxxxxxxxxx
# Get your API key from: https://zuno-marketplace-metadata.vercel.app/api/docs
METADATA_SERVICE_API_KEY=zuno_xxxxxxxxxxxxxxxx-key-xxxxxxxxxxxx

# ============================================
# MONITORING (Optional)
# ============================================
# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
