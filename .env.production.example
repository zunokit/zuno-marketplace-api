# ============================================
# Zuno Marketplace - Production Environment
# Infrastructure Mode: Docker
# ============================================
# This configuration uses Docker containers or AWS-managed services
# for production deployment.
# ============================================

# Infrastructure Mode
INFRA_MODE=docker

# ============================================
# CORE APPLICATION
# ============================================
ENVIRONMENT=production
PORT=8080

# ============================================
# AUTHENTICATION
# ============================================
JWT_SECRET=your-production-jwt-secret-min-32-chars
REFRESH_SECRET=your-production-refresh-secret-min-32-chars

# ============================================
# DATABASE (AWS RDS or Docker)
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=nft_marketplace

# Alternative: Use full connection URL for managed databases
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ============================================
# REDIS (AWS ElastiCache or Docker)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# Alternative: Use full connection URL for managed Redis
# REDIS_URL=redis://host:6379

# ============================================
# MESSAGE QUEUE (AWS MQ or Docker)
# ============================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=nft_events

# Alternative: Use full connection URL for managed RabbitMQ
# CLOUDAMQP_URL=amqp://user:password@host/vhost

# ============================================
# SERVICES PORTS (gRPC)
# ============================================
# Active microservices
AUTH_GRPC_PORT=:50051
USER_GRPC_PORT=:50052
WALLET_GRPC_PORT=:50053

# GraphQL Gateway
GATEWAY_HTTP_ADDR=:8080

# ============================================
# SERVICE URLs (for inter-service communication)
# ============================================
USER_SERVICE_URL=localhost:50052
WALLET_SERVICE_URL=localhost:50053
