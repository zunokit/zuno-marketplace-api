apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: dev
type: Opaque
stringData:
  # Authentication Secrets
  JWT_SECRET: "your-jwt-secret-change-in-production"
  REFRESH_SECRET: "your-refresh-secret-change-in-production"

  # Database Credentials
  POSTGRES_PASSWORD: "postgres"
  RABBITMQ_PASSWORD: "guest"

  # Metadata Service (Upload & IPFS)
  # Production service deployed on Vercel
  METADATA_SERVICE_URL: "https://zuno-marketplace-metadata.vercel.app/api"
  # Format: zuno_xxxxxxxxxxxxxxxx-key-xxxxxxxxxxxx
  METADATA_SERVICE_API_KEY: "zuno_xxxxxxxxxxxxxxxx-key-xxxxxxxxxxxx"
