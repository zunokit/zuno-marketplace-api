# ============================================================
# Kubernetes Secrets for Production (Docker Mode)
# ============================================================
# Copy this file to secrets.yaml and fill in actual values
# DO NOT commit secrets.yaml to git
#
# K8s runs with INFRA_MODE=docker
# Infrastructure pods: postgres, redis, rabbitmq (in cluster)
# ============================================================

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: dev
type: Opaque
stringData:
  # ============================================================
  # JWT Authentication
  # ============================================================
  JWT_SECRET: "your-production-jwt-secret-min-32-chars"
  REFRESH_SECRET: "your-production-refresh-secret-min-32-chars"
  JWT_ACCESS_SECRET: "your-production-jwt-access-secret-min-32-chars"

  # ============================================================
  # Infrastructure (Docker Mode - pods in cluster)
  # ============================================================
  POSTGRES_PASSWORD: "postgres"
  REDIS_PASSWORD: ""
  RABBITMQ_PASSWORD: "guest"

  # ============================================================
  # Metadata Service API Key (Upload & IPFS)
  # ============================================================
  METADATA_SERVICE_URL: "https://zuno-marketplace-metadata-q3ollndpn-zuno-kit.vercel.app/api"
  # Format: zuno_xxxxxxxxxxxxxxxx-key-xxxxxxxxxxxx
  METADATA_SERVICE_API_KEY: "zuno_xxxxxxxxxxxxxxxx-key-xxxxxxxxxxxx"

  # ============================================================
  # Webhook Secret (for indexer webhook signature verification)
  # ============================================================
  WEBHOOK_SECRET: "your-webhook-secret-change-in-production"

  # ============================================================
  # Sentry - Error Tracking (Optional)
  # ============================================================
  SENTRY_DSN: ""
  SENTRY_ENVIRONMENT: "production"
