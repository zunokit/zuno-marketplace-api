# Kubernetes Secrets for Development
# Copy this file to secrets.yaml and fill in actual values
# DO NOT commit secrets.yaml to git

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: dev
type: Opaque
stringData:
  # ===================================
  # Authentication Secrets
  # ===================================
  JWT_SECRET: "your-jwt-secret-change-in-production"
  REFRESH_SECRET: "your-refresh-secret-change-in-production"

  # ===================================
  # Docker Mode Secrets (Local Infra)
  # ===================================
  POSTGRES_PASSWORD: "postgres"
  RABBITMQ_PASSWORD: "guest"

  # ===================================
  # Serverless Mode Secrets (Cloud Infra)
  # ===================================
  # Supabase PostgreSQL - Full connection URL with credentials
  DATABASE_URL: "postgresql://postgres:YOUR_PASSWORD@db.xqsujkyuargadsnrikme.supabase.co:5432/postgres"

  # Upstash Redis - Full connection URL with credentials (TLS enabled)
  # Format: rediss://:PASSWORD@HOST:PORT
  REDIS_URL: "rediss://:YOUR_PASSWORD@tender-stag-16168.upstash.io:6379"

  # CloudAMQP RabbitMQ - Full connection URL with credentials
  CLOUDAMQP_URL: "amqps://USER:PASSWORD@kingfisher.lmq.cloudamqp.com/YOUR_VHOST"
