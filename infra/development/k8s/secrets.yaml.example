apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: dev
type: Opaque
stringData:
  # ===================================
  # Authentication Secrets
  # ===================================
  JWT_SECRET: "your-jwt-secret-change-in-production"
  REFRESH_SECRET: "your-refresh-secret-change-in-production"

  # ===================================
  # Docker Mode Secrets (Local Infra)
  # ===================================
  POSTGRES_PASSWORD: "postgres"
  RABBITMQ_PASSWORD: "guest"

  # ===================================
  # Serverless Mode Secrets (Cloud Infra)
  # ===================================
  # Supabase Configuration
  SUPABASE_DATABASE_URL: "postgresql://postgres:password@host:5432/database"
  SUPABASE_ANON_KEY: "your-supabase-anon-key"
  SUPABASE_SERVICE_ROLE_KEY: "your-supabase-service-role-key"

  # Upstash Redis Configuration
  UPSTASH_REDIS_REST_TOKEN: "your-upstash-rest-token"

  # CloudAMQP Configuration
  RABBITMQ_URL: "amqps://user:password@host/vhost"
  CLOUDAMQP_URL: "amqps://user:password@host/vhost"
