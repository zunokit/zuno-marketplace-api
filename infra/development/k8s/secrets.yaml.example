# ============================================================
# Kubernetes Secrets for Production
# ============================================================
# Copy this file to secrets.yaml and fill in actual values
# DO NOT commit secrets.yaml to git
#
# Usage with Tiltfile.production
# ============================================================

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: dev
type: Opaque
stringData:
  # ============================================================
  # JWT Authentication
  # ============================================================
  JWT_SECRET: "your-production-jwt-secret-min-32-chars"
  REFRESH_SECRET: "your-production-refresh-secret-min-32-chars"
  JWT_ACCESS_SECRET: "your-production-jwt-access-secret-min-32-chars"

  # ============================================================
  # Database - Neon (Serverless PostgreSQL)
  # ============================================================
  DATABASE_URL: "postgres://postgres:[PASSWORD]@[PROJECT-ID].aws.neon.tech/neondb?sslmode=require"

  # ============================================================
  # Cache - Upstash (Serverless Redis)
  # ============================================================
  REDIS_URL: "redis://default:[PASSWORD]@xxx.upstash.io:6379"

  # ============================================================
  # Message Queue - CloudAMQP (Serverless RabbitMQ)
  # ============================================================
  CLOUDAMQP_URL: "amqp://[USER]:[PASSWORD]@[HOST]/[VHOST]"

  # ============================================================
  # Sentry - Error Tracking (Optional)
  # ============================================================
  SENTRY_DSN: ""
  SENTRY_ENVIRONMENT: "production"
